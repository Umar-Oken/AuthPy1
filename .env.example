# Copy to .env and replace every placeholder. Never use these values in production.
DJANGO_SECRET_KEY=replace-me-with-a-unique-random-secret
DJANGO_DEBUG=False
ALLOWED_HOSTS=your-domain.example
PUBLIC_ORIGIN=https://your-domain.example

DATABASE_NAME=auth_py1_db
DATABASE_USER=postgres
DATABASE_PASSWORD=replace-me
DATABASE_HOST=localhost
DATABASE_PORT=5432

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
DEFAULT_FROM_EMAIL=AuthLab <no-reply@your-domain.example>

SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=0
